  "projectType": "sdk-library",
  "projectName": "OuterProduct",
  "projectDescription": "OuterProduct is a Python SDK and API for training tabular ML models, generating predictions, and producing feature-level explanations — including counterfactuals and pattern aggregation — from a typed, minimal interface.",

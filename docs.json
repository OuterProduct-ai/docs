{
  "$schema": "https://mintlify.com/docs.json",
  "name": "OuterProduct",
  "theme": "mint",
  "logo": {
    "light": "/logo/op-logo-light.svg",
    "dark": "/logo/op-logo-dark.svg"
  },
  "favicon": "/logo/op-avatar.png",
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction",
      "permanent": true
    },
    {
      "source": "/use-cases/recommender",
      "destination": "/use-cases/recommendations",
      "permanent": true
    }
  ],
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Start for free",
      "href": "https://console.outerproduct.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ],
            "expanded": true
          },
          {
            "group": "Guides",
            "pages": [
              "guides/workspaces",
              "guides/training",
              "guides/predictions",
              "guides/explanations",
              "guides/scenarios",
              "guides/pattern-tracker"
            ]
          },
          {
            "group": "Data Connectors",
            "pages": [
              "guides/connectors/overview",
              "guides/connectors/file-upload",
              "guides/connectors/s3",
              "guides/connectors/snowflake",
              "guides/connectors/databricks"
            ]
          },
          {
            "group": "MCP Server",
            "pages": [
              "mcp/overview",
              "mcp/prompts"
            ]
          }
        ]
      },
      {
        "tab": "Use Cases",
        "pages": [
          "use-cases/underwriting",
          "use-cases/recommendations"
        ]
      },
      {
        "tab": "SDK Reference",
        "pages": [
          "sdk/overview",
          "sdk/workspace",
          "sdk/model",
          "sdk/trainer",
          "sdk/jobs",
          "sdk/tasks",
          "sdk/hpo"
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "https://api.outerproduct.com/openapi.json"
      }
    ]
  }
}

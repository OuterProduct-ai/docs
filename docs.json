{
  "$schema": "https://mintlify.com/docs.json",
  "name": "OuterProduct",
  "theme": "mint",
  "logo": {
    "light": "/logo/op-logo-light.svg",
    "dark": "/logo/op-logo-dark.svg"
  },
  "favicon": "/logo/op-avatar.png",
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction",
      "permanent": true
    },
    {
      "source": "/use-cases/recommender",
      "destination": "/use-cases/recommendations",
      "permanent": true
    }
  ],
  "colors": {
    "primary": "#000000",
    "light": "#FFFFFF",
    "dark": "#000000"
  },
  "navbar": {},
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "installation"
            ],
            "expanded": true
          },
          {
            "group": "Concepts",
            "pages": [
              "guides/workspaces",
              "guides/training",
              "guides/predictions",
              "guides/explanations",
              "guides/scenarios"
            ],
            "icon": "book"
          },
          {
            "group": "Data Connectors",
            "pages": [
              "guides/connectors/overview",
              "guides/connectors/file-upload",
              "guides/connectors/s3",
              "guides/connectors/snowflake",
              "guides/connectors/databricks"
            ]
          },
          {
            "group": "MCP Server",
            "pages": [
              "mcp/overview",
              "mcp/prompts"
            ],
            "hidden": true
          }
        ]
      },
      {
        "tab": "SDK Reference",
        "groups": [
          {
            "group": "Core",
            "pages": [
              "sdk/init",
              "sdk/dataset",
              "sdk/trainer"
            ]
          },
          {
            "group": "Models",
            "pages": [
              "sdk/model",
              "sdk/reasoning"
            ]
          },
          {
            "group": "Connectors",
            "pages": [
              "sdk/connectors"
            ]
          }
        ],
        "hidden": true
      },
      {
        "tab": "API Reference",
        "openapi": "https://api.outerproduct.com/openapi.json"
      }
    ]
  }
}
